# 按需复制为 .env.prod，仅覆盖生产环境的差异；不要在此设置 APP_ENV。
# 数据库连接与密钥可由系统环境变量注入。
LOG_LEVEL=info
LOG_FILE_PATH=
# 单机生产如果没有 journald 或日志 Agent，可改为：
# LOG_FILE_PATH=data/logs
# LOG_FILE_MAX_SIZE_MB=100
# LOG_FILE_MAX_BACKUPS=10
CORS_ENABLED=true
# 替换为生产环境管理网页的实际 Origin，不要包含路径或通配符。
CORS_ALLOWED_ORIGINS=https://zentrola.example.com
