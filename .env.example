# 通用配置。优先级：系统环境变量 > .env.{APP_ENV} > .env > 默认值，显式空值也会覆盖。
# APP_ENV 仅在系统环境变量或此文件设置；取值 dev / test / prod，默认 dev。
APP_ENV=dev
HTTP_ADDR=:9527
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=20s
STARTUP_TIMEOUT=30s
HEALTH_CHECK_TIMEOUT=2s

LOG_LEVEL=info
LOG_FORMAT=text

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=zentrola
POSTGRES_USER=zentrola
# 填入数据库密码；PostgreSQL Docker 示例首次启动也使用此密码。
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
MIGRATIONS_AUTO_APPLY=true
ID_NODE=1

# 仅首次 Bootstrap 生效；运行时业务配置以 PostgreSQL 为准。
BOOTSTRAP_SONNET_MODEL=claude-sonnet-5
BOOTSTRAP_OPUS_MODEL=claude-opus-5

# 初始管理员通过网页创建，不预设用户名密码。
# 独立随机签名密钥：至少 32 bytes 的 Base64，不能与 Master Key 共用。
ADMIN_JWT_SECRET=
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_DURATION=15m

# 未显式提供 ACP_MASTER_KEY / ACP_MASTER_KEY_FILE 时，自动生成并持久化。
MASTER_KEY_PATH=data/secrets/master.key
# ACP_MASTER_KEY=Base64_encoded_32_random_bytes
# ACP_MASTER_KEY_FILE=/run/secrets/zentrola_master_key

# 管理网页独立部署；此处必须填写浏览器实际访问的网页 Origin。
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Gateway：请求体最大 32 MiB，整个上游请求最长 15 分钟；SSE 不先聚合再输出。
GATEWAY_MAX_BODY_BYTES=33554432
GATEWAY_REQUEST_TIMEOUT=15m
GATEWAY_HEADER_TIMEOUT=120s
GATEWAY_BODY_READ_TIMEOUT=30s
GATEWAY_WRITE_TIMEOUT=30s

# 固定一个 Usage Worker；队列满时当前请求同步写入。
USAGE_QUEUE_SIZE=10000
USAGE_BATCH_SIZE=100
USAGE_FLUSH_INTERVAL=500ms
USAGE_WRITE_TIMEOUT=3s
USAGE_SHUTDOWN_TIMEOUT=5s

# Compose 自带数据库使用独立端口，避免与现有 PostgreSQL 冲突。
POSTGRES_PUBLISHED_PORT=15432
